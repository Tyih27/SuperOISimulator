POSTGRES_USER=super_oi
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=super_oi
POSTGRES_PORT=5432
DATABASE_URL=postgresql://super_oi:replace-with-a-local-password@127.0.0.1:5432/super_oi
SESSION_SECRET=replace-with-at-least-32-random-characters
SECURE_COOKIES=false
# Comma-separated trusted browser origins. Keep production deployments to their public HTTPS origin.
APP_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Optional URL opened automatically on startup; use the machine's LAN/public origin when needed.
BROWSER_ORIGIN=http://127.0.0.1:3000
# Open the local app in the default browser after the server starts.
OPEN_BROWSER=true

